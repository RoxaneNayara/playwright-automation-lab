{
  "name": "playwright-automation-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratório de automação de testes Web com Playwright e TypeScript, utilizando TodoMVC e SauceDemo.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:todo": "playwright test --project=web-todo",
    "test:todo:headed": "playwright test --project=web-todo --headed",
    "test:saucedemo": "playwright test --project=web-saucedemo",
    "test:saucedemo:headed": "playwright test --project=web-saucedemo --headed",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:chromium": "playwright test --project=web-todo-chromium --project=web-saucedemo-chromium",
    "test:firefox": "playwright test --project=web-todo-firefox --project=web-saucedemo-firefox",
    "test:webkit": "playwright test --project=web-todo-webkit --project=web-saucedemo-webkit",
    "test:cross-browser": "playwright test",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report",
    "report:serve": "allure serve ./allure-results",
    "report": "npm run report:generate && npm run report:open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.7.5",
    "allure-playwright": "^3.4.1",
    "eslint": "^9.13.0",
    "eslint-plugin-playwright": "^2.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
